<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_defaultbackground">

    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/color_textdark"
        android:gravity="center"
        android:paddingVertical="8dp"/>

    <ImageView
        android:id="@+id/ivMainImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/main_title"
        android:src="@drawable/chinese_municipalities"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_prompt"
        android:textColor="@color/color_textdark"
        android:textStyle="bold"
        android:paddingTop="12dp"/>

    <EditText
        android:id="@+id/etMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_municipality"
        android:inputType="textCapWords"
        android:imeOptions="actionGo"
        android:maxLines="1"
        android:singleLine="true"/>
</LinearLayout>